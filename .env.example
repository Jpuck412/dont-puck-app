# ============================================================
# APPLICATION
# ============================================================
# Public URL of the control-plane app. Vercel sets this automatically
# in preview/production; only needed for local reference.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================
# DATABASE  (Phase 1)
# ============================================================
# Postgres connection string. Provision via Vercel dashboard ->
# Storage -> Neon. Vercel injects this automatically once connected.
DATABASE_URL=

# ============================================================
# AUTHENTICATION  (Phase 1)
# ============================================================
# Better Auth. Required on Vercel; required on the worker only if it
# ever needs to verify a session directly.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ============================================================
# ENCRYPTION  (Phase 1)
# ============================================================
# Master key for encrypting stored provider keys / integration
# credentials (AES-256-GCM). Generate with: openssl rand -base64 32
# Required on Vercel only.
MASTER_ENCRYPTION_KEY=

# ============================================================
# REDIS  (Phase 2 — worker)
# ============================================================
# Upstash Redis. Provision via Vercel Marketplace, or connect
# directly on Railway. Required on the worker.
REDIS_URL=

# ============================================================
# OBJECT STORAGE  (Phase 2)
# ============================================================
# Vercel Blob. Provision via Vercel dashboard -> Storage -> Blob.
BLOB_READ_WRITE_TOKEN=

# ============================================================
# WORKER  (Phase 2)
# ============================================================
# Shared secret the control plane signs requests with; the worker
# rejects anything unsigned. Required on both.
WORKER_API_SECRET=
# Base URL of the deployed worker service (Railway). Required on Vercel.
WORKER_BASE_URL=

# ============================================================
# GITHUB  (Phase 6 — the platform's own GitHub App, not this repo)
# ============================================================
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_WEBHOOK_SECRET=

# ============================================================
# VERCEL  (Phase 7 — the platform's own Vercel integration)
# ============================================================
VERCEL_INTEGRATION_CLIENT_ID=
VERCEL_INTEGRATION_CLIENT_SECRET=

# ============================================================
# AI PROVIDERS  (Phase 3 — all optional; the platform never requires one)
# ============================================================
# Local/self-hosted gateway — the default unlimited path.
LOCAL_MODEL_GATEWAY_URL=
LOCAL_MODEL_GATEWAY_API_KEY=
# BYOK — only used if a user connects their own key.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# ============================================================
# OBSERVABILITY  (Phase 8)
# ============================================================
OTEL_EXPORTER_OTLP_ENDPOINT=

# ============================================================
# EMAIL  (Phase 1 — password reset, invitations)
# ============================================================
EMAIL_FROM=
RESEND_API_KEY=

# ============================================================
# SECURITY  (Phase 8)
# ============================================================
RATE_LIMIT_REDIS_URL=
